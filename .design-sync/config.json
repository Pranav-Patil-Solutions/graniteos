{
  "projectId": "78de2c95-9435-45ce-bdbf-b2e4205f367a",
  "shape": "package",
  "pkg": "graniteos",
  "globalName": "GraniteOS",
  "srcDir": "src/components/ui",
  "tsconfig": ".design-sync/.cache/tsconfig.dssync.json",
  "entry": ".design-sync/.cache/ds-entry.ts",
  "cssEntry": ".design-sync/.cache/ds-tailwind.css",
  "buildCmd": "node_modules/.bin/tailwindcss -i src/app/globals.css -o .design-sync/.cache/ds-tailwind.css --minify",
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "BottomNav": { "cardMode": "single", "primaryStory": "DefaultNav" },
    "StickyTotalBar": { "cardMode": "single", "primaryStory": "InvoiceBar" },
    "ProgressSplit": { "cardMode": "column" },
    "TrendChart": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "AnimatedNumber": "src/components/ui/AnimatedNumber.tsx",
    "AppBar": "src/components/ui/AppBar.tsx",
    "BottomNav": "src/components/ui/BottomNav.tsx",
    "Button": "src/components/ui/Button.tsx",
    "Card": "src/components/ui/Card.tsx",
    "EmptyState": "src/components/ui/EmptyState.tsx",
    "FilterChip": "src/components/ui/FilterChips.tsx",
    "FilterChipsRow": "src/components/ui/FilterChips.tsx",
    "ListRow": "src/components/ui/ListRow.tsx",
    "ProgressSplit": "src/components/ui/ProgressSplit.tsx",
    "RoleBadge": "src/components/ui/RoleBadge.tsx",
    "SlabCard": "src/components/ui/SlabCard.tsx",
    "SlabSection": "src/components/ui/SlabCard.tsx",
    "MoneyInput": "src/components/ui/SlabInputs.tsx",
    "QtyInput": "src/components/ui/SlabInputs.tsx",
    "StatCard": "src/components/ui/StatCard.tsx",
    "StatTile": "src/components/ui/StatTile.tsx",
    "StatusBadge": "src/components/ui/StatusBadge.tsx",
    "StickyTotalBar": "src/components/ui/StickyTotalBar.tsx",
    "PrimaryButton": "src/components/ui/StoneButton.tsx",
    "GhostButton": "src/components/ui/StoneButton.tsx",
    "StoneCard": "src/components/ui/StoneCard.tsx",
    "TiltCard": "src/components/ui/TiltCard.tsx",
    "TrendChart": "src/components/ui/TrendChart.tsx"
  }
}
