# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only HMAC secret for the MFA "second factor cleared" cookie. REQUIRED in
# production (the app refuses to run MFA without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_COOKIE_SECRET=
# Licensing (wired, off by default). Set LICENSE_ENFORCE=1 to lock the app — then
# a valid GRANITEOS_LICENSE token (mint via scripts/gen-license.mjs) is required
# to run. Leave LICENSE_ENFORCE unset to run without any licence (current default).
LICENSE_ENFORCE=
GRANITEOS_LICENSE=
# Used to build invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Private-beta gate. Comma-separated invited emails/phones. Empty = open (dev).
# Only these logins can sign in or be created while set.
BETA_ALLOWED_LOGINS=
# Set to 1 on the beta deploy to keep it out of search engines.
BETA_NOINDEX=
# Groq (AI marketing copy)
GROQ_API_KEY=
# Google AI Studio key for "See it in your space" photoreal preview (Gemini 2.5 Flash Image)
GEMINI_API_KEY=
# WhatsApp Business API (Path B — hands-off auto-send of stock alerts).
# Leave blank to keep the free one-tap (Path A) flow. Meta Cloud API by default;
# point WHATSAPP_API_BASE at a BSP (Gupshup/WATI) that mirrors the same shape.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE=
# Approved marketing template name + language for the new-stock alert.
WHATSAPP_STOCK_TEMPLATE=new_stock_alert
WHATSAPP_TEMPLATE_LANG=en
